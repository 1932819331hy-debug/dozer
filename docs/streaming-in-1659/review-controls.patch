+fn independent_cte_unaliased_nested_join_control() {
+ let runtime = create_test_runtime();
+ let sql = "WITH local AS (SELECT Country FROM users), nested AS (WITH local AS (SELECT CustomerID FROM allowed) SELECT CustomerID FROM local) SELECT users.* INTO results FROM users JOIN local ON users.Country = local.Country JOIN nested ON users.CustomerID = nested.CustomerID";
+ let dag=membership_test_dag(sql,false,runtime.clone()).unwrap();
+ runtime.block_on(DagExecutor::new(dag,Default::default())).unwrap();
+}
